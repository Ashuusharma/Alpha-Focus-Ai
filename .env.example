OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Separate model for photo analysis (Vision migration, phase 1). Configured
# independently of OPENAI_MODEL so cost/accuracy can be tuned separately.
OPENAI_VISION_MODEL=gpt-4.1-mini
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
NOTIFICATION_SCHEDULER_SECRET=

# Leave unset in real production. Only set to "true" for local/CI e2e runs
# that exercise a production build (`next build && next start`) against
# /test-auth (the Playwright e2e suite's sign-up/sign-in helper page).
# Not needed for `npm run dev` — that page is always enabled there.
NEXT_PUBLIC_ENABLE_TEST_ROUTES=
