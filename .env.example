OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Separate model for photo analysis (Vision migration, phase 1). Configured
# independently of OPENAI_MODEL so cost/accuracy can be tuned separately.
OPENAI_VISION_MODEL=gpt-4.1-mini
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
NOTIFICATION_SCHEDULER_SECRET=
# Accepted as an alternate to NOTIFICATION_SCHEDULER_SECRET for authorizing
# POST /api/notifications/scheduler (either header/bearer value works). Set
# this on Vercel if you're triggering the scheduler via Vercel Cron, which
# conventionally uses the name CRON_SECRET.
CRON_SECRET=

# Shared secret for POST /api/protocol/worker (the background protocol-
# generation job runner). Required for that route to accept requests.
PROTOCOL_WORKER_SECRET=

# Leave unset in real production. Only set to "true" for local/CI e2e runs
# that exercise a production build (`next build && next start`) against
# /test-auth (the Playwright e2e suite's sign-up/sign-in helper page).
# Not needed for `npm run dev` — that page is always enabled there.
NEXT_PUBLIC_ENABLE_TEST_ROUTES=

# AI cost/rate governance (lib/ai/aiGovernanceConfig.ts). All optional —
# defaults shown are what's used if unset, and match what was previously
# hardcoded inline, so leaving these unset does not change existing behavior.
#
# Soft budget: requests keep processing, a warning is logged and surfaced in
# GET /api/admin/ai-usage. Hard budget: the real OpenAI call is skipped and
# the request falls through to the existing graceful fallback (Galaxy AI /
# baseline markers for Vision, the template report for Protocol) — the
# fallback response itself is unchanged, it's just now properly attributed
# in ai_usage_log (success=false, failure_reason="...budget_exceeded").
AI_GOVERNANCE_SOFT_DAILY_BUDGET_USD=4
AI_GOVERNANCE_HARD_DAILY_BUDGET_USD=5
AI_GOVERNANCE_SOFT_MONTHLY_BUDGET_USD=80
AI_GOVERNANCE_HARD_MONTHLY_BUDGET_USD=100
AI_GOVERNANCE_MAX_VISION_RPM=20
AI_GOVERNANCE_MAX_PROTOCOL_RPM=12
AI_GOVERNANCE_MAX_TOKENS_PER_REQUEST=4200
# Protocol's own completion-token target (Phase 5.9 truncation fix). Data-
# justified: measured completion tokens across real generations were
# 2134-2966; 3800 gives ~28% headroom. Do not lower this below ~3000 without
# re-measuring — the old default of 2200 truncated most generations.
PROTOCOL_AI_MAX_TOKENS=3800
AI_GOVERNANCE_MAX_IMAGE_SIZE_MB=6

# How long a Vision analysis result stays cached per (image set, category,
# model, prompt version). Default 24h.
VISION_CACHE_TTL_MS=86400000

# Required to read GET /api/admin/ai-usage (the internal cost dashboard).
# Send as either the "x-admin-secret" header or "Authorization: Bearer ...".
# Leave unset to keep the dashboard fully disabled.
AI_ADMIN_SECRET=

# Phase 6: subscription billing (lib/payments/*). Which PaymentProvider
# implementation getPaymentProvider() returns — see lib/payments/paymentService.ts.
# Only "cashfree" exists today; adding Razorpay/Stripe later means a new
# provider class plus a branch there, not a change to any calling code.
PAYMENT_PROVIDER=cashfree

# Cashfree Sandbox credentials only (https://sandbox.cashfree.com) — this app
# does not process production payments yet. Get these from the Cashfree
# dashboard's Sandbox API keys section.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# Legacy/fallback photo-analysis provider — used only when the primary
# OpenAI Vision path throws (see the try/catch in app/api/galaxy/analyze/
# route.ts). Optional: if unset, that fallback itself degrades further to a
# baseline-marker response rather than erroring, so this is safe to leave
# empty entirely.
GALAXY_API_KEY=
# Alternate name accepted for GALAXY_API_KEY (either works).
GALAXY_BEARER_TOKEN=
GALAXY_API_URL=https://api.galaxy.ai/photo-analyzer

# Supabase Storage bucket name used for uploaded analyzer photos. Must exist
# in the Supabase project (see supabase/photo_storage_setup.sql) before
# photo uploads will work.
NEXT_PUBLIC_SUPABASE_ANALYZER_BUCKET=analyzer-scans

# Fine-grained Vision/Protocol AI tuning (lib/ai/visionAnalysis.ts,
# lib/ai/protocolGovernance.ts). All optional — defaults shown match what's
# used if unset.
VISION_AI_TIMEOUT_MS=25000
VISION_AI_MAX_RETRIES=1
VISION_AI_MAX_TOKENS=1200
VISION_UPLOAD_TIMEOUT_MS=20000
PROTOCOL_AI_TIMEOUT_MS=20000
PROTOCOL_AI_MAX_RETRIES=2
PROTOCOL_AI_CACHE_TTL_MS=900000
PROTOCOL_AI_MAX_PROMPT_CHARS=14000
PROTOCOL_AI_MODEL_MINI=gpt-5.4-mini
PROTOCOL_AI_MODEL_NANO=gpt-5.4-nano
PROTOCOL_PROMPT_VERSION=v2.0.0
# Used only by GET /api/ai/health to compute an estimated-remaining-budget
# figure for display; does not enforce a hard cap anywhere.
PROTOCOL_DAILY_TOKEN_BUDGET=1200000
